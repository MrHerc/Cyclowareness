# Cyclowareness frontend — environment
#
# Every value here is optional. The defaults are correct for the way the product
# actually ships: one Docker image where FastAPI serves both the API and the
# compiled SPA, so the two share an origin and there is no CORS and no
# cross-origin WebSocket.
#
# Copy to `.env.local` to override locally. Never commit `.env.local`.

# Base URL for the API. Empty means "same origin as this page", which is the
# production arrangement. Set it only for a split deployment where the SPA is
# hosted separately from the API (e.g. VITE_API_BASE_URL=https://api.example.com).
VITE_API_BASE_URL=

# How long a single request may take before the client gives up and shows a
# timeout state. A request that hangs forever is a spinner that never resolves,
# which is the worst state a live demonstration can be in.
VITE_API_TIMEOUT_MS=30000

# Product name shown in the shell and the browser title. Configurable so a pilot
# customer can see their own branding without a code change.
VITE_PRODUCT_NAME=Cyclowareness

# --- local development only ---------------------------------------------------
# The dev server proxies /api to the backend. These are read by vite.config.ts,
# not by the app, and exist so a second checkout (a git worktree) can run its own
# pair of servers without colliding with the primary one on 5173/8000.
# PORT=5173
# VITE_API_TARGET=http://127.0.0.1:8000
